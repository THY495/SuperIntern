# 复制为 .env 后填入（也可以在看板「设置 → 服务商」里粘贴，只写进这个文件）。.env 在 .gitignore 里，不会被提交。
# Copy to .env and fill in (or paste keys in the web UI: Settings → Providers; they are written only to this file).
# 只填你手头有的那家即可；没填 key 的厂商会被跳过。自己加的服务商用自己起的变量名，同样写在这里。
# Fill in only the vendors you have; vendors without a key are skipped.

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenRouter 聚合网关（OpenAI 兼容协议）/ OpenRouter aggregator (OpenAI-compatible)
OPENROUTER_API_KEY=

# 交付时在 GitHub 上开 PR 用；不填就只 push 不开 PR / Used to open a PR on delivery; without it SuperIntern only pushes
GITHUB_TOKEN=

# 部署级通知通道（可空；个人通道在「设置 → 成员」里挂）。webhook URL 含密钥，日志只记种类与主机名。
# Deployment-wide notification channels (optional). Webhook URLs contain secrets; only kind + host are logged.
NTFY_URL=
FEISHU_WEBHOOK=
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=
NOTIFY_CMD=
